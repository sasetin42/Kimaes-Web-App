rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'super_admin' || 
        request.auth.token.email == 'admin@gmail.com'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() in ['admin', 'super_admin'] ||
        request.auth.token.email == 'admin@gmail.com'
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        getUserRole() in ['admin', 'super_admin', 'manager', 'cashier', 'inventory_staff', 'kitchen', 'rider'] ||
        request.auth.token.email == 'admin@gmail.com'
      );
    }

    function isManager() {
      return isAuthenticated() && (
        getUserRole() in ['manager', 'admin', 'super_admin'] ||
        request.auth.token.email == 'admin@gmail.com'
      );
    }

    function isCashier() {
      return isAuthenticated() && (
        getUserRole() in ['cashier', 'manager', 'admin', 'super_admin'] ||
        request.auth.token.email == 'admin@gmail.com'
      );
    }

    function isKitchen() {
      return isAuthenticated() && (
        getUserRole() in ['kitchen', 'manager', 'admin', 'super_admin'] ||
        request.auth.token.email == 'admin@gmail.com'
      );
    }

    function isRider() {
      return isAuthenticated() && (
        getUserRole() in ['rider', 'admin', 'super_admin'] ||
        request.auth.token.email == 'admin@gmail.com'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ----------------------------------------------------
    // Users Collection
    // ----------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions'])))
      );
      allow delete: if isSuperAdmin();
    }

    // ----------------------------------------------------
    // Products & Categories
    // ----------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ----------------------------------------------------
    // Orders Collection
    // ----------------------------------------------------
    match /orders/{orderId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid) || true;
      allow create: if true;
      allow update: if isStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // ----------------------------------------------------
    // POS Transactions & Shifts
    // ----------------------------------------------------
    match /pos_transactions/{transactionId} {
      allow read: if isCashier();
      allow create: if isCashier();
      allow update: if isManager();
      allow delete: if isSuperAdmin();
    }

    match /pos_shifts/{shiftId} {
      allow read: if isCashier();
      allow create, update: if isCashier();
      allow delete: if isSuperAdmin();
    }

    // ----------------------------------------------------
    // Inventory Movements, Suppliers & POs
    // ----------------------------------------------------
    match /inventory_movements/{movementId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isSuperAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /purchase_orders/{poId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // Customer Profiles & CRM
    // ----------------------------------------------------
    match /customer_profiles/{customerId} {
      allow read: if isStaff() || (isAuthenticated() && request.auth.uid == customerId);
      allow create, update: if isStaff() || (isAuthenticated() && request.auth.uid == customerId);
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // Notifications
    // ----------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isStaff() || isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ----------------------------------------------------
    // Store Settings, Delivery Zones, Promos, Reviews
    // ----------------------------------------------------
    match /store_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /delivery_zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
    }
  }
}
